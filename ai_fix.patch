diff --git a/fs/readdir.c b/fs/readdir.c
--- a/fs/readdir.c
+++ b/fs/readdir.c
@@ -25,6 +25,36 @@
 
 #ifdef CONFIG_KSU_SUSFS_SUS_PATH
 extern __attribute__((hot)) bool susfs_is_inode_sus_path(struct inode *inode);
+
+struct susfs_readdir_check_ctx {
+	unsigned long ino;
+	bool is_sus;
+};
+
+static int susfs_readdir_check_sus_path(struct inode *inode, void *data)
+{
+	struct susfs_readdir_check_ctx *ctx = data;
+
+	if (inode->i_ino == ctx->ino &&
+	    !(inode->i_state & (I_NEW | I_FREEING | I_WILL_FREE))) {
+		if (susfs_is_inode_sus_path(inode))
+			ctx->is_sus = true;
+	}
+	return 0;
+}
+
+static inline bool susfs_is_ino_sus_path_nowait(struct super_block *sb, u64 ino)
+{
+	struct susfs_readdir_check_ctx ctx = {
+		.ino = (unsigned long)ino,
+		.is_sus = false,
+	};
+
+	if (!susfs_is_current_app_uid() || unlikely(!sb))
+		return false;
+	ilookup5_nowait(sb, ctx.ino, susfs_readdir_check_sus_path, &ctx);
+	return ctx.is_sus;
+}
 #endif // #ifdef CONFIG_KSU_SUSFS_SUS_PATH
 
