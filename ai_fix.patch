diff --git a/fs/super.c b/fs/super.c
--- a/fs/super.c
+++ b/fs/super.c
@@ -934,14 +934,26 @@ int get_anon_bdev(dev_t *p)
 #ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
 	if (static_branch_unlikely(&susfs_is_sdcard_android_data_not_decrypted)) {
 		if (susfs_is_current_ksu_domain()) {
-			dev = ida_simple_get(&unnamed_dev_ida, DEFAULT_KSU_MNT_MINOR_DEV,
-					     (1 << MINORBITS), GFP_ATOMIC);
-			if (dev == -ENOSPC)
-				dev = -EMFILE;
-			if (dev < 0)
-				return dev;
-
-			*p = MKDEV(0, dev);
+ksu_retry:
+			if (ida_pre_get(&unnamed_dev_ida, GFP_ATOMIC) == 0)
+				return -ENOMEM;
+
+			spin_lock(&unnamed_dev_lock);
+			error = ida_get_new_above(&unnamed_dev_ida,
+						  DEFAULT_KSU_MNT_MINOR_DEV,
+						  &dev);
+			spin_unlock(&unnamed_dev_lock);
+			if (error == -EAGAIN)
+				goto ksu_retry;
+			if (error)
+				return error == -ENOSPC ? -EMFILE : -EAGAIN;
+			if (dev >= (1 << MINORBITS)) {
+				spin_lock(&unnamed_dev_lock);
+				ida_remove(&unnamed_dev_ida, dev);
+				spin_unlock(&unnamed_dev_lock);
+				return -EMFILE;
+			}
+			*p = MKDEV(0, dev & MINORMASK);
 			return 0;
 		}
 	}
