+ksu_retry:
+			if (ida_pre_get(&unnamed_dev_ida, GFP_ATOMIC) == 0)
+				return -ENOMEM;
+
+			spin_lock(&unnamed_dev_lock);
+			error = ida_get_new_above(&unnamed_dev_ida,
